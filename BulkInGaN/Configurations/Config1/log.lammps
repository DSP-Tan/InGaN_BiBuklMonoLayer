LAMMPS (16 Feb 2016)
# Initialize:

clear
units metal
dimension 3
boundary p p p
atom_style full

angle_style class2
bond_style class2

# Read the atom positions from data file
read_data data.lammps
  orthogonal box = (0 0 0) to (204.096 176.747 103.72)
  2 by 2 by 2 MPI processor grid
  reading atoms ...
  327680 atoms
  scanning bonds ...
  4 = max bonds/atom
  scanning angles ...
  6 = max angles/atom
  reading bonds ...
  655360 bonds
  reading angles ...
  1966080 angles
  4 = max # of 1-2 neighbors
  12 = max # of 1-3 neighbors
  48 = max # of 1-4 neighbors
  41 = max # of special neighbors

neighbor 2.1 bin
#neigh_modify once yes
#neigh_modify delay 10 check yes
#neigh_modify binsize 10
#neigh_modify binsize 6

#atom_modify sort 100 10

special_bonds lj/coul 1.0 1.0 1.0
  4 = max # of 1-2 neighbors
  4 = max # of special neighbors
pair_style coul/long 15
pair_coeff * *
pair_modify table 0
kspace_style pppm 1e-8

dump     1    all  custom 10000 dump.lammps   id   x      y      z
dump_modify 1 format "%6d %11.6lf %11.6lf %11.6lf"
restart 10000 large*.restart

group corner id 1
1 atoms in group corner
fix cornerfix corner setforce 0.0 0.0 0.0
thermo_style custom step pe ebond epair eangle

min_modify line quadratic
min_style cg


#Relax only atomic positions with low tolerance
minimize 1e-12 1e-12 5000000 100000
